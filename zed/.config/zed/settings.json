{
  "autosave": "on_window_change",
  "cli_default_open_behavior": "new_window",
  "ui_font_family": "MonoLisaText",
  "buffer_font_family": "MonoLisaCode",
  "buffer_font_fallbacks": ["Symbols Nerd Font Mono"],
  "buffer_font_size": 16,
  "buffer_font_features": {
    // MonoLisaCode Ligatures
    "ss11": true,
    "ss13": true,
    "cv01": true,
    "cv02": true,
    "cv04": true,
    "cv05": true,
    "cv08": true,
    "cv09": true
  },
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "git_panel": {
    "group_by": "staging"
  },
  "file_types": {
    "Shell Script": ["conf"],
  },
  "languages": {
    "Lua": {
      "enable_language_server": false,
    },
  },
}
